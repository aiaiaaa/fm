        this.__glowOpacity.purgeDependencyOnElmtId(rmElmtId);
    }
    aboutToBeDeleted() {
        this.__isPlaying.aboutToBeDeleted();
        this.__isLoading.aboutToBeDeleted();
        this.__mode.aboutToBeDeleted();
