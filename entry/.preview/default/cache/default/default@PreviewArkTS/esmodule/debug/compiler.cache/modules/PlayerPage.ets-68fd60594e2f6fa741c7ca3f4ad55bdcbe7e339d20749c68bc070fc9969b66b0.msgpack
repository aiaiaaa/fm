    aboutToAppear() {
        // çŠ¶æ€æ é¿è®©é«˜åº¦
        window.getLastWindow(getContext(this)).then(win => {
            const area = win.getWindowAvoidArea(window.AvoidAreaType.TYPE_SYSTEM);
            this.statusBarHeight = px2vp(area.topRect.height);
        }).catch(() => {
            this.statusBarHeight = 40;
        });
        // ç”Ÿæˆæ˜Ÿç©º
        const list = [];
        for (let i = 0; i < 60; i++) {
            list.push({
                x: Math.random() * 100,
                y: Math.random() * 100,
                size: Math.random() < 0.15 ? 2.5 : 1.5,
                opacity: 0.25 + Math.random() * 0.55
            });
        }
        this.stars = list;
        // åˆå§‹åŒ–æ’­æ”¾å™¨ + AVSession + åå°ä»»åŠ¡
        const context = getContext(this);
        this.player.init(context, {
            onStateChange: (s) => {
                switch (s) {
                    case 'loading':
                        this.isLoading = true;
                        break;
                    case 'playing':
                        this.isLoading = false;
                        this.isPlaying = true;
                        this.startRhythm();
                        BackgroundTask.start(context);
                        break;
                    case 'paused':
                    case 'idle':
                        this.isPlaying = false;
                        this.isLoading = false;
                        this.stopRhythm();
                        break;
                    case 'error':
                        this.isPlaying = false;
                        this.isLoading = false;
                        this.stopRhythm();
                        break;
                    default:
                        break;
                }
            },
            onError: (msg) => {
                promptAction.showToast({ message: `æ’­æ”¾å¤±è´¥: ${msg}`, duration: 2500 });
            }
        });
        this.startLogoAnim();
        this.startGlowAnim();
    }
    aboutToDisappear() {
        this.stopRhythm();
        if (this.logoTimer >= 0) {
            clearInterval(this.logoTimer);
        }
        const context = getContext(this);
        BackgroundTask.stop(context);
        this.player.release();
    }
    /* ============ åŠ¨ç”» ============ */
    startLogoAnim() {
        this.logoTimer = setInterval(() => {
            Context.animateTo({ duration: 420, curve: Curve.EaseInOut }, () => {
                this.logoBars = [
                    6 + Math.random() * 10,
                    8 + Math.random() * 14,
                    6 + Math.random() * 10,
                    7 + Math.random() * 12
                ];
            });
        }, 450);
    }
    startGlowAnim() {
        Context.animateTo({
            duration: 1800,
            curve: Curve.EaseInOut,
            iterations: -1,
            playMode: PlayMode.Alternate
        }, () => {
            this.glowScale = 1.18;
            this.glowOpacity = 0.55;
        });
    }
    startRhythm() {
        if (this.rhythmTimer >= 0) {
            return;
        }
        // ç¼©çŸ­åˆ·æ–°é—´éš”ï¼Œæå‡æµç•…åº¦ï¼ˆ150msçº¦ç­‰äº 6~7 fps çš„å…³é”®å¸§å˜æ¢ï¼Œé…åˆ animateTo å½¢æˆä¸æ»‘è¿‡æ¸¡ï¼‰
        this.rhythmTimer = setInterval(() => {
            // æ¯æ¬¡åˆ·æ–°æ¨è¿›ç›¸ä½
            this.wavePhase += 0.4;
            Context.animateTo({ duration: 150, curve: Curve.Linear }, () => {
                const arr = [];
                const TOTAL_DOTS = 23;
                const CENTER = Math.floor(TOTAL_DOTS / 2); // 11
                for (let i = 0; i < TOTAL_DOTS; i++) {
                    // 1. å°†ç´¢å¼•æ˜ å°„åˆ° -1.0 åˆ° 1.0 çš„èŒƒå›´
                    const x = (i - CENTER) / CENTER;
                    // 2. é«˜æ–¯åŒ…ç»œçº¿ (Gaussian Envelope)ï¼šå¼ºåˆ¶æ³¢å½¢å‘ˆç°ä¸­é—´é«˜ã€ä¸¤è¾¹å¹³æ»‘è¡°å‡çš„å½¢æ€
                    // Math.exp(-x * x * 3) ä¸­çš„ 3 å†³å®šäº†è¡°å‡çš„é™¡å³­ç¨‹åº¦
                    const envelope = Math.exp(-x * x * 3);
                    // 3. å¤åˆæ³¢åŠ¨ç”Ÿæˆï¼šæ¨¡æ‹Ÿä½ã€ä¸­ã€é«˜é¢‘çš„ç»„åˆ
                    // - ä½é¢‘ (Low): æ§åˆ¶æ•´ä½“çš„å¹³ç¼“å‘¼å¸
                    const lowFreq = Math.sin(this.wavePhase * 0.8) * 0.3;
                    // - ä¸­é¢‘ (Mid): éšç´¢å¼•ä½ç½®å˜åŒ–çš„æ¶Ÿæ¼ªæ„Ÿ
                    const midFreq = Math.sin(this.wavePhase * 1.5 + i * 0.6) * 0.4;
                    // - é«˜é¢‘/èŠ‚å¥ (High): æå°å¹…åº¦çš„éšæœºæŠ–åŠ¨ï¼Œæ¨¡æ‹Ÿé¼“ç‚¹
                    const beat = (Math.random() * 0.15 - 0.075);
                    // 4. åˆæˆç»å¯¹å€¼ï¼Œå¹¶åº”ç”¨åŒ…ç»œçº¿
                    let waveHeight = Math.abs(lowFreq + midFreq + beat) * envelope;
                    // 5. æ˜ å°„åˆ°è§†è§‰ç¼©æ”¾æ¯”ä¾‹ (åŸºç¡€é«˜åº¦ 0.2ï¼Œæœ€å¤§é«˜åº¦ä¸Šé™é€šè¿‡å¸¸æ•°æ§åˆ¶)
                    const scaleY = Math.max(0.2, 0.2 + waveHeight * 2.5);
                    arr.push(scaleY);
                }
                this.dotScales = arr;
            });
        }, 150);
    }
    stopRhythm() {
        if (this.rhythmTimer >= 0) {
            clearInterval(this.rhythmTimer);
            this.rhythmTimer = -1;
        }
        // åœæ­¢æ—¶ï¼Œå¹³æ»‘å›è½åˆ°ä¸€æ¡é™æ­¢çš„å¾®å°ç›´çº¿
        Context.animateTo({ duration: 600, curve: Curve.EaseOut }, () => {
            this.dotScales = new Array(23).fill(0.15);
        });
    }
    /* ============ äº¤äº’ ============ */
    currentUrl() {
        // ä¸“æ³¨æ¨¡å¼åŒºåˆ†ä¸­è‹±æ–‡ï¼Œç¡çœ æ¨¡å¼å›ºå®š
        if (this.mode === 'focus') {
            return this.lang === 'cn'
                ? 'https://ngcdn001.cnr.cn/live/zgzs/index.m3u8'
                : 'https://koe.bbg.fm/channels/2/playlist.m3u8';
        }
        return MODES.sleep.url;
    }
    getCurrentModeConfig() {
        return this.mode === 'focus' ? MODES.focus : MODES.sleep;
    }
    modeCfgOf(m) {
        if (m === 'focus')
            return MODES.focus;
        return MODES.sleep;
    }
    async togglePlay() {
        if (this.isLoading) {
            return;
        }
        if (this.isPlaying) {
            await this.player.pause();
        }
        else {
            const cfg = this.getCurrentModeConfig();
            this.player.setTrack({
                title: `X.FM - ${this.mode === 'focus' ? (this.lang === 'cn' ? 'ä¸­æ–‡' : 'EN') : 'ç¡çœ '}`,
                artist: 'X.FM',
                album: cfg.subtitle
            });
            await this.player.load(this.currentUrl());
        }
    }
    async switchMode(m) {
        if (this.mode === m) {
            return;
        }
        this.mode = m;
        if (this.isPlaying || this.isLoading) {
            await this.player.stop();
            await this.player.load(this.currentUrl());
        }
    }
    async switchLang(l) {
        if (this.lang === l) {
            return;
        }
        this.lang = l;
        if (this.isPlaying || this.isLoading) {
            await this.player.stop();
            await this.player.load(this.currentUrl());
        }
    }
