//# sourceMappingURL=PlayerPage.js.mapÂ–Ùi␀hvigor_ignore__Applications_DevEco-Studio.app_Contents_sdk_default_openharmony_ets_api_@ohos.window.d.tsÙo␀hvigor_ignore__Applications_DevEco-Studio.app_Contents_sdk_default_openharmony_ets_api_@ohos.promptAction.d.tsÙP/Users/xthon/DevEcoStudioProjects/fm/entry/src/main/ets/services/RadioPlayer.etsÙS/Users/xthon/DevEcoStudioProjects/fm/entry/src/main/ets/services/BackgroundTask.etsÙG/Users/xthon/DevEcoStudioProjects/fm/entry/src/main/ets/model/Modes.etsÙM/Users/xthon/DevEcoStudioProjects/fm/entry/src/main/ets/components/Meteor.etsÙL/Users/xthon/DevEcoStudioProjects/fm/entry/src/main/ets/pages/PlayerPage.etsÔrB›ªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo¯hostModulesInfo°belongModulePath¬shouldEmitJs¥entryÃÂÙ*/Users/xthon/DevEcoStudioProjects/fm/entryÙ$/Users/xthon/DevEcoStudioProjects/fm¥entry¥1.0.0Ô␀␀‘ÔrC’²hostDependencyName®hostModuleName¬./PlayerPage¥entryÙ*/Users/xthon/DevEcoStudioProjects/fm/entryÃÃÚJ©import window from '@ohos.window';
import promptAction from '@ohos.promptAction';
import common from '@ohos.app.ability.common';
import { RadioPlayer, PlayerState } from '../services/RadioPlayer';
import { BackgroundTask } from '../services/BackgroundTask';
import { MODES, ModeId, ModeConfig } from '../model/Modes';
import { Meteor } from '../components/Meteor';

interface StarDot {
  x: number;
  y: number;
  size: number;
  opacity: number;
}

@Component
export struct PlayerPage {
  @State isPlaying: boolean = false;
  @State isLoading: boolean = false;
  @State mode: ModeId = 'focus';
  @State lang: 'cn' | 'en' = 'cn';
  @State statusBarHeight: number = 40;

  // ç‚¹é˜µéŸ³æ³¢ â€”â€” æŒ‰æˆªå›¾ï¼šä¸€æ’ 23 é¢—åœ†ç‚¹ï¼Œä¸­é—´é«˜ä¸¤å¤´ä½
  @State dotScales: number[] = new Array(23).fill(0.4);
  private rhythmTimer: number = -1;

  // logo 4 æ ¹æŸ±å­
  @State logoBars: number[] = [10, 16, 8, 13];
  private logoTimer: number = -1;

  // æ’­æ”¾æŒ‰é’®å¤–åœˆå…‰æ™•å‘¼å¸
  @State glowScale: number = 1.0;
  @State glowOpacity: number = 0.35;

  // æ˜Ÿç©º
  private stars: StarDot[] = [];

  private player: RadioPlayer = new RadioPlayer();

  aboutToAppear(): void {
    // çŠ¶æ€æ é¿è®©é«˜åº¦
    window.getLastWindow(getContext(this)).then(win => {
      const area = win.getWindowAvoidArea(window.AvoidAreaType.TYPE_SYSTEM);
      this.statusBarHeight = px2vp(area.topRect.height);
    }).catch(() => {
      this.statusBarHeight = 40;
    });

    // ç”Ÿæˆæ˜Ÿç©º
    const list: StarDot[] = [];
    for (let i = 0; i < 60; i++) {
      list.push({
        x: Math.random() * 100,
        y: Math.random() * 100,
        size: Math.random() < 0.15 ? 2.5 : 1.5,
        opacity: 0.25 + Math.random() * 0.55
      });
    }
    this.stars = list;

    // åˆå§‹åŒ–æ’­æ”¾å™¨ + AVSession + åå°ä»»åŠ¡
    const context = getContext(this) as common.UIAbilityContext;
    this.player.init(context, {
      onStateChange: (s: PlayerState) => {
        switch (s) {
          case 'loading':
            this.isLoading = true;
            break;
          case 'playing':
            this.isLoading = false;
            this.isPlaying = true;
            this.startRhythm();
            BackgroundTask.start(context);
            break;
          case 'paused':
          case 'idle':
            this.isPlaying = false;
            this.isLoading = false;
            this.stopRhythm();
            break;
          case 'error':
            this.isPlaying = false;
            this.isLoading = false;
            this.stopRhythm();
            break;
          default:
            break;
        }
      },
      onError: (msg: string) => {
        promptAction.showToast({ message: `æ’­æ”¾å¤±è´¥: ${msg}`, duration: 2500 });
      }
    });

    this.startLogoAnim();
    this.startGlowAnim();
  }

  aboutToDisappear(): void {
    this.stopRhythm();
    if (this.logoTimer >= 0) {
      clearInterval(this.logoTimer);
    }
    const context = getContext(this) as common.UIAbilityContext;
    BackgroundTask.stop(context);
    this.player.release();
  }

  /* ============ åŠ¨ç”» ============ */

  private startLogoAnim(): void {
    this.logoTimer = setInterval(() => {
      animateTo({ duration: 420, curve: Curve.EaseInOut }, () => {
        this.logoBars = [
          6 + Math.random() * 10,
          8 + Math.random() * 14,
          6 + Math.random() * 10,
          7 + Math.random() * 12
        ];
      });
    }, 450);
  }

  private startGlowAnim(): void {
    animateTo({
      duration: 1800,
      curve: Curve.EaseInOut,
      iterations: -1,
      playMode: PlayMode.Alternate
    }, () => {
      this.glowScale = 1.18;
      this.glowOpacity = 0.55;
    });
  }

  private wavePhase: number = 0;

  private startRhythm(): void {
    if (this.rhythmTimer >= 0) {
      return;
    }
    // ç¼©çŸ­åˆ·æ–°é—´éš”ï¼Œæå‡æµç•…åº¦ï¼ˆ150msçº¦ç­‰äº 6~7 fps çš„å…³é”®å¸§å˜æ¢ï¼Œé…åˆ animateTo å½¢æˆä¸æ»‘è¿‡æ¸¡ï¼‰
    this.rhythmTimer = setInterval(() => {
      // æ¯æ¬¡åˆ·æ–°æ¨è¿›ç›¸ä½
      this.wavePhase += 0.4;

      animateTo({ duration: 150, curve: Curve.Linear }, () => {
        const arr: number[] = [];
        const TOTAL_DOTS = 23;
        const CENTER = Math.floor(TOTAL_DOTS / 2); // 11

        for (let i = 0; i < TOTAL_DOTS; i++) {
          // 1. å°†ç´¢å¼•æ˜ å°„åˆ° -1.0 åˆ° 1.0 çš„èŒƒå›´
          const x = (i - CENTER) / CENTER;

          // 2. é«˜æ–¯åŒ…ç»œçº¿ (Gaussian Envelope)ï¼šå¼ºåˆ¶æ³¢å½¢å‘ˆç°ä¸­é—´é«˜ã€ä¸¤è¾¹å¹³æ»‘è¡°å‡çš„å½¢æ€
          // Math.exp(-x * x * 3) ä¸­çš„ 3 å†³å®šäº†è¡°å‡çš„é™¡å³­ç¨‹åº¦
          const envelope = Math.exp(-x * x * 3);

          // 3. å¤åˆæ³¢åŠ¨ç”Ÿæˆï¼šæ¨¡æ‹Ÿä½ã€ä¸­ã€é«˜é¢‘çš„ç»„åˆ
          // - ä½é¢‘ (Low): æ§åˆ¶æ•´ä½“çš„å¹³ç¼“å‘¼å¸
          const lowFreq = Math.sin(this.wavePhase * 0.8) * 0.3;
          // - ä¸­é¢‘ (Mid): éšç´¢å¼•ä½ç½®å˜åŒ–çš„æ¶Ÿæ¼ªæ„Ÿ
          const midFreq = Math.sin(this.wavePhase * 1.5 + i * 0.6) * 0.4;
          // - é«˜é¢‘/èŠ‚å¥ (High): æå°å¹…åº¦çš„éšæœºæŠ–åŠ¨ï¼Œæ¨¡æ‹Ÿé¼“ç‚¹
          const beat = (Math.random() * 0.15 - 0.075);

          // 4. åˆæˆç»å¯¹å€¼ï¼Œå¹¶åº”ç”¨åŒ…ç»œçº¿
          let waveHeight = Math.abs(lowFreq + midFreq + beat) * envelope;
          // 5. æ˜ å°„åˆ°è§†è§‰ç¼©æ”¾æ¯”ä¾‹ (åŸºç¡€é«˜åº¦ 0.2ï¼Œæœ€å¤§é«˜åº¦ä¸Šé™é€šè¿‡å¸¸æ•°æ§åˆ¶)
          const scaleY = Math.max(0.2, 0.2 + waveHeight * 2.5);
          arr.push(scaleY);
        }
        this.dotScales = arr;
      });
    }, 150);
  }

  private stopRhythm(): void {
    if (this.rhythmTimer >= 0) {
      clearInterval(this.rhythmTimer);
      this.rhythmTimer = -1;
    }
    // åœæ­¢æ—¶ï¼Œå¹³æ»‘å›è½åˆ°ä¸€æ¡é™æ­¢çš„å¾®å°ç›´çº¿
    animateTo({ duration: 600, curve: Curve.EaseOut }, () => {
      this.dotScales = new Array(23).fill(0.15);
    });
  }

  /* ============ äº¤äº’ ============ */

  private currentUrl(): string {
    // ä¸“æ³¨æ¨¡å¼åŒºåˆ†ä¸­è‹±æ–‡ï¼Œç¡çœ æ¨¡å¼å›ºå®š
    if (this.mode === 'focus') {
      return this.lang === 'cn'
        ? 'https://ngcdn001.cnr.cn/live/zgzs/index.m3u8'
        : 'https://koe.bbg.fm/channels/2/playlist.m3u8';
    }
    return MODES.sleep.url;
  }

  private getCurrentModeConfig(): ModeConfig {
    return this.mode === 'focus' ? MODES.focus : MODES.sleep;
  }

  private modeCfgOf(m: ModeId): ModeConfig {
    if (m === 'focus') return MODES.focus;
    return MODES.sleep;
  }

  private async togglePlay(): Promise<void> {
    if (this.isLoading) {
      return;
    }
    if (this.isPlaying) {
      await this.player.pause();
    } else {
      const cfg = this.getCurrentModeConfig();
      this.player.setTrack({
        title: `X.FM - ${this.mode === 'focus' ? (this.lang === 'cn' ? 'ä¸­æ–‡' : 'EN') : 'ç¡çœ '}`,
        artist: 'X.FM',
        album: cfg.subtitle
      });
      await this.player.load(this.currentUrl());
    }
  }

  private async switchMode(m: ModeId): Promise<void> {
    if (this.mode === m) {
      return;
    }
    this.mode = m;
    if (this.isPlaying || this.isLoading) {
      await this.player.stop();
      await this.player.load(this.currentUrl());
    }
  }

  private async switchLang(l: 'cn' | 'en'): Promise<void> {
    if (this.lang === l) {
      return;
    }
    this.lang = l;
    if (this.isPlaying || this.isLoading) {
      await this.player.stop();
      await this.player.load(this.currentUrl());
    }
  }

  /* ============ UI ============ */

  // é¡¶éƒ¨å¯¼èˆª
  @Builder
  TopNav(cfg: ModeConfig) {
    Row() {
      Row({ space: 8 }) {
        Row({ space: 3 }) {
          ForEach([0, 1, 2, 3], (i: number) => {
            Column()
              .width(3)
              .height(this.logoBars[i])
              .borderRadius(2)
              .linearGradient({
                angle: 180,
                colors: [[cfg.accent, 0], [cfg.accentSecond, 1]]
              })
          })
        }
        .alignItems(VerticalAlign.Center)
        .height(22)

        Text('X.FM')
          .fontSize(20)
          .fontWeight(FontWeight.Bold)
          .fontColor('#FFFFFF')
          .letterSpacing(1.5)
      }
      .alignItems(VerticalAlign.Center)
    }
    .width('100%')
    .height(48)
    .padding({ left: 24, right: 24 })
    .justifyContent(FlexAlign.Start)
    .margin({ top: this.statusBarHeight })
  }

  // æ˜Ÿç©ºå±‚
  @Builder
  StarField() {
    Stack() {
      ForEach(this.stars, (s: StarDot, idx: number) => {
        Column()
          .width(s.size)
          .height(s.size)
          .borderRadius(s.size / 2)
          .backgroundColor('#FFFFFF')
          .opacity(s.opacity)
          .position({ x: `${s.x}%`, y: `${s.y}%` })
      }, (s: StarDot, idx: number) => `star-${idx}`)
    }
    .width('100%')
    .height('100%')
  }

  // æµæ˜Ÿå±‚ â€”â€” 6 æ¡æ–œå‘åˆ’è¿‡
  @Builder
  MeteorField(cfg: ModeConfig) {
    Stack() {
      Meteor({ startLeft: 75, delay: 0,    duration: 2200, cycle: 7000, color: cfg.accent })
      Meteor({ startLeft: 60, delay: 1400, duration: 2000, cycle: 6500, color: cfg.accent })
      Meteor({ startLeft: 85, delay: 2800, duration: 2400, cycle: 7500, color: cfg.accentSecond })
      Meteor({ startLeft: 45, delay: 4000, duration: 1800, cycle: 6800, color: cfg.accent })
      Meteor({ startLeft: 70, delay: 5200, duration: 2100, cycle: 7200, color: cfg.accentSecond })
      Meteor({ startLeft: 55, delay: 6400, duration: 1900, cycle: 6600, color: cfg.accent })
    }
    .width('100%')
    .height('100%')
    .clip(true)
  }

  // ç‚¹é˜µéŸ³æ³¢ â€”â€” ä¸€æ’ 23 é¢—åœ†ç‚¹
  @Builder
  DotVisualizer(cfg: ModeConfig) {
    Row({ space: 6 }) {
      ForEach(this.dotScales, (scale: number, idx: number) => {
        Column()
          .width(6)
          .height(6)
          .borderRadius(3)
          .backgroundColor(cfg.accent)
          .scale({ x: 1, y: scale })
          .opacity(0.6 + scale * 0.4)
          .shadow({
            radius: this.isPlaying ? 4 : 0,
            color: cfg.accent,
            offsetX: 0,
            offsetY: 0
          })
      }, (_: number, idx: number) => `dot-${idx}`)
    }
    .justifyContent(FlexAlign.Center)
    .alignItems(VerticalAlign.Center)
    .height(40)
    .width('100%')
    .margin({ top: 30, bottom: 30 })
  }

  // ä¸­å¿ƒåœ†å½¢æ’­æ”¾æŒ‰é’®ï¼ˆæˆªå›¾æ ·å¼ï¼šå¤§åœ†ç»¿è‰²å…‰æ™•ï¼‰
  @Builder
  PlayButton(cfg: ModeConfig) {
    Stack() {
      // å¤–å…‰æ™•ï¼ˆå‘¼å¸ï¼‰
      Column()
        .width(110)
        .height(110)
        .borderRadius(55)
        .backgroundColor(cfg.accent)
        .opacity(this.isPlaying ? this.glowOpacity * 0.6 : 0.25)
        .scale({ x: this.glowScale, y: this.glowScale })

      // ä¸»æŒ‰é’®
      Stack() {
        if (this.isLoading) {
          LoadingProgress()
            .width(34)
            .height(34)
            .color('#0A0E27')
        } else if (this.isPlaying) {
          Row({ space: 8 }) {
            Column().width(6).height(26).backgroundColor('#0A0E27').borderRadius(2)
            Column().width(6).height(26).backgroundColor('#0A0E27').borderRadius(2)
          }
        } else {
          // æ’­æ”¾ä¸‰è§’ â–¶
          Polygon({ width: 22, height: 24 })
            .points([[0, 0], [22, 12], [0, 24]])
            .fill('#0A0E27')
            .stroke(Color.Transparent)
            .margin({ left: 4 })
        }
      }
      .width(84)
      .height(84)
      .borderRadius(42)
      .backgroundColor(cfg.accent)
      .alignContent(Alignment.Center)
      .shadow({ radius: 24, color: cfg.accent, offsetX: 0, offsetY: 0 })
    }
    .width(110)
    .height(110)
    .alignContent(Alignment.Center)
    .onClick(() => this.togglePlay())
  }

  // å·¦å³åˆ‡å°ç®­å¤´
  @Builder
  ArrowButton(direction: 'left' | 'right') {
    Stack() {
      Text(direction === 'left' ? '\u2039' : '\u203A')
        .fontSize(30)
        .fontColor('#FFFFFF55')
        .fontWeight(FontWeight.Lighter)
    }
    .width(44)
    .height(44)
    .alignContent(Alignment.Center)
    .onClick(() => {
      // å¿«é€Ÿåˆ‡æ¢ä¸­è‹±æ–‡ï¼ˆä»… focus æ¨¡å¼æœ‰æ•ˆæœï¼‰
      if (this.mode === 'focus') {
        this.switchLang(this.lang === 'cn' ? 'en' : 'cn');
      }
    })
  }

  // æ¨¡å¼åˆ‡æ¢ï¼ˆä¸“æ³¨ / ç¡çœ ï¼‰
  @Builder
  ModeSwitch(cfg: ModeConfig) {
    Row() {
      ForEach(['focus', 'sleep'] as ModeId[], (m: ModeId) => {
        Text(m === 'focus' ? MODES.focus.label : MODES.sleep.label)
          .fontSize(13)
          .fontColor(this.mode === m ? '#0A0E27' : '#FFFFFFAA')
          .fontWeight(this.mode === m ? FontWeight.Bold : FontWeight.Regular)
          .padding({ left: 18, right: 18, top: 7, bottom: 7 })
          .borderRadius(16)
          .backgroundColor(this.mode === m ? (m === 'focus' ? MODES.focus.accent : MODES.sleep.accent) : '#00000000')
          .animation({ duration: 250, curve: Curve.EaseOut })
          .onClick(() => this.switchMode(m))
      })
    }
    .padding(3)
    .borderRadius(20)
    .backgroundColor('#FFFFFF10')
    .border({ width: 1, color: '#FFFFFF18' })
    .margin({ top: 22 })
  }

  // å¡ç‰‡å¤´éƒ¨æ ‡ç­¾
  @Builder
  CardHeader(cfg: ModeConfig) {
    Row() {
      Row({ space: 8 }) {
        // ç»¿è‰²å‘¼å¸ç‚¹
        Stack() {
          Column()
            .width(8).height(8)
            .borderRadius(4)
            .backgroundColor(cfg.accent)
            .shadow({ radius: 8, color: cfg.accent, offsetX: 0, offsetY: 0 })
        }
        Text(cfg.tag)
          .fontSize(12)
          .fontColor(cfg.accent)
          .fontWeight(FontWeight.Medium)
      }
      .alignItems(VerticalAlign.Center)

      Blank()

      // å³ä¾§ LIVE èƒ¶å›Š
      Row({ space: 6 }) {
        Column()
          .width(6).height(6)
          .borderRadius(3)
          .backgroundColor(this.isPlaying ? '#FF5353' : '#888888')
        Text('LIVE')
          .fontSize(11)
          .fontColor('#FFFFFFAA')
          .letterSpacing(1)
      }
      .alignItems(VerticalAlign.Center)
      .padding({ left: 10, right: 10, top: 4, bottom: 4 })
      .borderRadius(12)
      .backgroundColor('#FFFFFF10')
      .border({ width: 1, color: '#FFFFFF18' })
    }
    .width('100%')
    .padding({ left: 22, right: 18, top: 22 })
  }

  // ä¸»æ’­æ”¾å¡ç‰‡
  // ä¸»æ’­æ”¾å¡ç‰‡ (å¢åŠ æ¯›ç»ç’ƒè´¨æ„Ÿ)
  @Builder
  PlayerCard(cfg: ModeConfig) {
    Stack() {
      // 1. ç§»é™¤çº¯å®è‰²æˆ–ç”Ÿç¡¬çš„æ¸å˜ï¼Œæ”¹ç”¨è¾ƒä½é€æ˜åº¦çš„èƒŒæ™¯ + èƒŒæ™¯æ¨¡ç³Š (æ¯›ç»ç’ƒ)
      Column()
        .width('100%').height('100%')
        .borderRadius(28)
        .backgroundColor('#1AFFFFFF') // æä½çš„ç™½è‰²é€æ˜åº¦
        .backdropBlur(20) // ã€æ–°å¢ã€‘é¸¿è’™åŸç”Ÿæ¯›ç»ç’ƒæ•ˆæœï¼Œè´¨æ„Ÿæå‡å…³é”®
        .border({ width: 1, color: '#33FFFFFF' }) // å¢å¼ºè¾¹ç¼˜é«˜å…‰è¾¹ç¼˜

      // æ˜Ÿç©ºä¸æµæ˜Ÿï¼ˆä¿æŒåœ¨åº•å±‚ï¼‰
      this.StarField()
      this.MeteorField(cfg)

      Column() {
        this.CardHeader(cfg)

        Column() {
          this.ModeSwitch(cfg)

          // ã€ä¼˜åŒ–ã€‘åˆå¹¶æ–‡æœ¬ï¼Œé¿å…ä¸­è‹±æ–‡åˆ†ç¦»å¯¼è‡´çš„å¯¹é½é—®é¢˜
          Text(`X.FM - ${this.mode === 'focus' ? (this.lang === 'cn' ? 'ä¸­æ–‡' : 'EN') : 'ç¡çœ '}`)
            .fontSize(34)
            .fontWeight(FontWeight.Bold)
            .fontColor('#FFFFFF')
            .margin({ top: 18 })
            .letterSpacing(2) // å¢åŠ å­—é—´è·æå‡é«˜çº§æ„Ÿ

          Text(cfg.subtitle)
            .fontSize(14)
            .fontColor('#FFFFFFBB')
            .margin({ top: 8 })

          Text(cfg.desc)
            .fontSize(12)
            .fontColor('#FFFFFF66')
            .letterSpacing(2)
            .margin({ top: 6 })

          this.DotVisualizer(cfg)

          // ã€ä¼˜åŒ–ã€‘é‡æ„æ§åˆ¶æ ï¼šç§»é™¤äº§ç”Ÿæ­§ä¹‰çš„è¯­è¨€åˆ‡æ¢ç®­å¤´
          Row() {
            // å¦‚æœåªæœ‰å•å‘æ’­æ”¾ï¼Œå¯ä»¥è€ƒè™‘æ”¾å…¥å…¶ä»–åŠŸèƒ½é”®ï¼Œä¾‹å¦‚ï¼šæ”¶è—ã€å®šæ—¶
            // æ­¤å¤„ç”¨é€æ˜å ä½ç¬¦ä¿æŒæ’­æ”¾æŒ‰é’®å±…ä¸­ï¼Œæˆ–è€…ç›´æ¥å»æ‰ä¸¤è¾¹
            Blank().width(44)
            this.PlayButton(cfg)
            Blank().width(44)
          }
          .width('100%')
          .justifyContent(FlexAlign.Center)
          .margin({ top: 6, bottom: 32 })
        }
        .width('100%')
        .alignItems(HorizontalAlign.Center)
        .layoutWeight(1)
        .justifyContent(FlexAlign.SpaceBetween)
      }
      .width('100%').height('100%')
    }
    .width('100%')
    .aspectRatio(0.78)
    .borderRadius(28)
    .clip(true)
    .shadow({ radius: 30, color: '#00000088', offsetX: 0, offsetY: 20 }) // é˜´å½±ä¸‹ç§»ï¼Œå¢å¼ºæ‚¬æµ®æ„Ÿ
  }

  // åº•éƒ¨èƒ¶å›Š (ç»“åˆé€»è¾‘ä¼˜åŒ–)
  @Builder
  BottomControls(cfg: ModeConfig) {
    Column() {
      // ã€ä¼˜åŒ–ã€‘æ¡ä»¶æ¸²æŸ“ï¼šåªæœ‰ focus æ¨¡å¼æ‰æ˜¾ç¤º Channelï¼Œsleep æ¨¡å¼å¯ä»¥æ˜¾ç¤ºå®šæ—¶å™¨æˆ–ç•™ç™½
      if (this.mode === 'focus') {
        Text('CHANNELS')
          .fontSize(11)
          .fontColor('#FFFFFF55')
          .letterSpacing(4)
          .margin({ bottom: 14 })

        Row() {
          ForEach(['cn', 'en'] as Array<'cn' | 'en'>, (l: 'cn' | 'en') => {
            Text(l === 'cn' ? 'ä¸­æ–‡' : 'EN')
              .fontSize(14)
              .fontColor(this.lang === l ? cfg.accent : '#FFFFFFAA')
              .fontWeight(this.lang === l ? FontWeight.Bold : FontWeight.Regular)
              .padding({ left: 30, right: 30, top: 10, bottom: 10 })
              .borderRadius(22)
              .backgroundColor(this.lang === l ? '#11FFFFFF' : 'transparent') // å¢åŠ é€‰ä¸­çŠ¶æ€åº•è‰²
              .border(
                this.lang === l
                  ? { width: 1, color: cfg.accent }
                  : { width: 1, color: 'transparent' }
              )
              .animation({ duration: 250, curve: Curve.EaseOut })
              .onClick(() => this.switchLang(l))
          })
        }
        .padding(3)
        .borderRadius(26)
        .backgroundColor('#FFFFFF10')
        .backdropBlur(15) // ã€æ–°å¢ã€‘åŒæ ·ä½¿ç”¨æ¯›ç»ç’ƒ
        .border({ width: 1, color: '#FFFFFF15' })
      } else {
        // Sleep æ¨¡å¼ä¸‹çš„å ä½æˆ–å®šæ—¶å™¨ UI
        Text('SLEEP TIMER')
          .fontSize(11)
          .fontColor('#FFFFFF55')
          .letterSpacing(4)
          .margin({ bottom: 14 })
      }
    }
    .width('100%')
    .height(100) // ç»™äºˆå›ºå®šé«˜åº¦ï¼Œé˜²æ­¢åˆ‡æ¢æ¨¡å¼æ—¶é¡µé¢è·³åŠ¨
    .alignItems(HorizontalAlign.Center)
    .margin({ bottom: 24 })
  }

  build() {
    Stack() {
      // ä¿æŒæ·±è‰²èƒŒæ™¯ï¼Œä½†æ¸å˜æ›´åŠ å¹³æ»‘
      Column()
        .width('100%').height('100%')
        .linearGradient({
          angle: 180,
          colors: [
            ['#070B1D', 0],   // ç¨å¾®åŠ æ·±é¡¶éƒ¨
            ['#111636', 0.5],
            ['#050814', 1]    // åº•éƒ¨æ›´æš—ï¼Œå‡¸æ˜¾å…‰æ•ˆ
          ]
        })

      Column() {
        this.TopNav(this.getCurrentModeConfig())

        Column() {
          this.PlayerCard(this.getCurrentModeConfig())
        }
        .layoutWeight(1)
        .justifyContent(FlexAlign.Center)
        .padding({ left: 24, right: 24 }) // è§„èŒƒåŒ–è¾¹è·

        this.BottomControls(this.getCurrentModeConfig()) // è°ƒç”¨ä¼˜åŒ–åçš„åº•éƒ¨æ§ä»¶
      }
      .width('100%').height('100%')
    }
    .width('100%').height('100%')
  }
}
