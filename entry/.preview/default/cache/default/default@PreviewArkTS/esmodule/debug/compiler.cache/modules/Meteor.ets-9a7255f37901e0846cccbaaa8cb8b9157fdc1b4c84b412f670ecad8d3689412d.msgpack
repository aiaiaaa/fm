//# sourceMappingURL=Meteor.js.mapÂÙM/Users/xthon/DevEcoStudioProjects/fm/entry/src/main/ets/components/Meteor.etsÔrB›ªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo¯hostModulesInfo°belongModulePath¬shouldEmitJs¥entryÃÂÙ*/Users/xthon/DevEcoStudioProjects/fm/entryÙ$/Users/xthon/DevEcoStudioProjects/fm¥entry¥1.0.0Ô␀␀‘ÔrC’²hostDependencyName®hostModuleName´../components/Meteor¥entryÙ*/Users/xthon/DevEcoStudioProjects/fm/entryÃÃÚ_/**
 * å•é¢—æµæ˜Ÿï¼šä»å³ä¸Š â†’ å·¦ä¸‹æ–œå‘åˆ’è¿‡å¡ç‰‡
 * ç”¨ç‹¬ç«‹ @Component + animateTo å¾ªç¯ï¼Œå®ç°çœŸæ­£"æµåŠ¨"çš„æ•ˆæœ
 */
@Component
export struct Meteor {
  @Prop startLeft: number = 60;   // èµ·ç‚¹æ¨ªåæ ‡ç™¾åˆ†æ¯”
  @Prop delay: number = 0;        // å¯åŠ¨å»¶è¿Ÿï¼ˆæ¯«ç§’ï¼‰
  @Prop duration: number = 2200;  // å•æ¬¡åˆ’è¿‡æ—¶é•¿
  @Prop cycle: number = 6000;     // ä¸‹æ¬¡å‡ºç°çš„å‘¨æœŸ
  @Prop color: string = '#2EE89D';

  @State translateX: number = 0;
  @State translateY: number = 0;
  @State meteorOpacity: number = 0;

  private timer: number = -1;

  aboutToAppear(): void {
    // å»¶è¿Ÿå¯åŠ¨ï¼Œé¿å…æ‰€æœ‰æµæ˜ŸåŒæ­¥
    setTimeout(() => {
      this.runOnce();
      this.timer = setInterval(() => this.runOnce(), this.cycle);
    }, this.delay);
  }

  aboutToDisappear(): void {
    if (this.timer >= 0) {
      clearInterval(this.timer);
    }
  }

  private runOnce(): void {
    // ç¬é—´å›åˆ°èµ·ç‚¹
    this.translateX = 0;
    this.translateY = 0;
    this.meteorOpacity = 0;

    animateTo({
      duration: 150,
      curve: Curve.EaseOut
    }, () => {
      this.meteorOpacity = 1;
    });

    animateTo({
      duration: this.duration,
      curve: Curve.EaseIn,
      onFinish: () => {
        this.meteorOpacity = 0;
      }
    }, () => {
      this.translateX = -220;
      this.translateY = 320;
    });
  }

  build() {
    // å…‰å°¾ï¼šä¸€æ¡å¸¦æ¸å˜çš„ç»†çº¿ï¼Œæ—‹è½¬ -30 åº¦
    Stack() {
      Column()
        .width(90)
        .height(1.5)
        .borderRadius(1)
        .linearGradient({
          angle: 90,
          colors: [
            ['#00000000', 0],
            [this.color, 0.6],
            ['#FFFFFFFF', 1]
          ]
        })

      // å¤´éƒ¨äº®ç‚¹
      Column()
        .width(4)
        .height(4)
        .borderRadius(2)
        .backgroundColor('#FFFFFF')
        .shadow({ radius: 6, color: this.color, offsetX: 0, offsetY: 0 })
        .position({ x: 86, y: -1 })
    }
    .rotate({ angle: -30 })
    .position({ x: `${this.startLeft}%`, y: '-5%' })
    .translate({ x: this.translateX, y: this.translateY })
    .opacity(this.meteorOpacity)
  }
}
