      Text(title)
        .fontSize(15)
        .fontColor('#FFFFFF')
        .layoutWeight(1)
        .margin({ left: 8 })

      Toggle({ type: ToggleType.Switch, isOn: value })
        .selectedColor('#2EE89D')
        .onChange((isOn: boolean) => onChange(isOn))
    }
    .width('100%')
    .height(54)
    .padding({ left: 16, right: 16 })
  }

